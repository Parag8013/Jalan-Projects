node_modules/
.next/
.netlify/

# Anchored with a leading slash, and they must stay that way. An unanchored
# `build/` matches a directory of that name at ANY depth — which silently
# swallowed public/media/seq/build, the hero's 210 frames, so the deployed
# canvas had nothing to paint. Same trap waits for `out/`.
/out/
/build/
.env*
!.env.example
next-env.d.ts
*.tsbuildinfo
.DS_Store

# Raw Flow exports. Source material, not deployed — scripts/prepare-media.sh
# turns these into the web-ready sequences and clips in public/media. Keep them
# backed up somewhere outside the repo; they are what you re-cut from.
/media/
